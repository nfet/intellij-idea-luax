<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.kapresoft.luax</id>

    <!-- Public plugin name should be written in Title Case.
     Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Luax</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://www.kapresoft.com">Kapresoft</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[ A Lua plugin by kapresoft. This will help in live templates.]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <idea-version since-build="251"/>

    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.MyMessageBundle</resource-bundle>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Luax Notifications" displayType="BALLOON"/>
        <applicationService serviceImplementation="com.kapresoft.luax.LuaxAppSettings"/>
        <projectConfigurable
                parentId="tools"
                instance="com.kapresoft.luax.LuaxSettingsConfigurable"
                id="com.kapresoft.luax.LuaxSettingsConfigurable"
                displayName="Luax"/>
        <defaultLiveTemplates file="/liveTemplates/Lua.xml"/>
        <liveTemplateContext
                contextId="LUAX"
                implementation="com.kapresoft.luax.LuaTemplateContextType"/>
        <liveTemplateMacro
                implementation="com.kapresoft.luax.LuaFunctionNameMacro"
                id="luaFunctionName"/>
        <liveTemplateMacro
                implementation="com.kapresoft.luax.LuaCSVSelectionMacro"
                id="luaCSVSelection"/>
    </extensions>

    <actions resource-bundle="messages.MyMessageBundle">
        <group id="com.kapresoft.luax.MyGroup">
            <separator/>
            <action id="com.kapresoft.luax.LogKeyValuesPopupMenuAction"
                    class="com.kapresoft.luax.LogKeyValuesPopupMenuAction"/>
            <action id="com.kapresoft.luax.HexToFloatPopupMenuAction"
                    class="com.kapresoft.luax.HexToFloatPopupMenuAction"/>
            <action id="com.kapresoft.luax.FloatToHexPopupMenuAction"
                    class="com.kapresoft.luax.FloatToHexPopupMenuAction"/>
            <separator/>
            <add-to-group group-id="EditorPopupMenu" anchor="first" />
        </group>
    </actions>


</idea-plugin>
